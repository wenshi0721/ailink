# ============================================================
#  换行与编码约定
#  背景：本工作区混有 3 个 GBK 编码的 .bat 与 6 个 UTF-8 的 .bat，
#        且历史上因 CRLF/LF 不一致导致容器内脚本执行失败（$'\r': command not found）。
#        因此对 .bat 关闭一切自动转换，保证字节原样；其余文本统一 LF。
# ============================================================

* text=auto eol=lf

# Windows 批处理：禁止换行归一化，禁止编码转换（含 GBK 文件）
*.bat -text
*.cmd -text

# Shell / Python / Node 脚本与源码：统一 LF
*.sh    text eol=lf
*.py    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.xml   text eol=lf

# 容器安装脚本必须保持 LF，否则 proot 内 bash 解析失败
*.sh    text eol=lf

# 二进制：不做行尾与 diff 处理
*.rootfs binary
*.zip    binary
*.tar    binary
*.gz     binary
*.apk    binary
*.exe    binary
*.dll    binary
*.so     binary
*.png    binary
*.jpg    binary
*.db     binary
*.node   binary
